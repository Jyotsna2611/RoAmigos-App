rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all protects all collections (chats, friends, groups, notifications, etc.)
    match /{document=**} {
      allow read, write: if false;
    }

    // Public connection test doc check (used by client testFirestoreConnection)
    match /_connection_test/{docId} {
      allow get: if true;
      allow list, write: if false;
    }

    // User profiles: authenticated users can view profiles, but only create/update their own
    match /users/{userId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid;

      allow delete: if false;

      // Trips & Memories subcollection
      match /trips/{tripId} {
        // Owner can always read; friends can read if visibility is 'friends'
        allow get: if isSignedIn() && (request.auth.uid == userId || resource.data.visibility == 'friends');
        allow list: if isSignedIn() && request.auth.uid == userId;

        // Owner can create, update, and delete their own trips
        allow create, update, delete: if isSignedIn()
          && request.auth.uid == userId;
      }
    }

    // Username reservation registry
    match /usernames/{username} {
      // 1. Safe single-document existence check for unauthenticated users; collection list is blocked
      allow get: if true;
      allow list: if false;

      // 2. Creatable ONLY when:
      // - request.auth != null
      // - the username document does not already exist
      // - the stored uid equals request.auth.uid
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.uid == request.auth.uid;

      // 3. Username documents cannot be freely modified by arbitrary users; only owner can update or delete
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }
  }
}


