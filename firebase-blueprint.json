{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile for RoAmigos social discovery",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth User ID"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_.]+$",
          "description": "Unique explorer handle"
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "User email address"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 2000,
          "description": "User profile photo URL or Storage URL"
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "description": "Short explorer bio"
        },
        "interests": {
          "type": "array",
          "description": "List of travel and discovery interests"
        },
        "location": {
          "type": "string",
          "maxLength": 100,
          "description": "Base location or city"
        },
        "onlineStatus": {
          "type": "string",
          "description": "Online presence status"
        },
        "lastSeen": {
          "type": "string",
          "description": "Last activity timestamp string"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "friendsCount": {
          "type": "number",
          "description": "Count of connected friends"
        },
        "groupsCount": {
          "type": "number",
          "description": "Count of groups joined"
        },
        "savedPlacesCount": {
          "type": "number",
          "description": "Count of saved places"
        },
        "tripsCount": {
          "type": "number",
          "description": "Count of trips planned"
        }
      },
      "required": ["uid", "name", "username", "email"]
    },
    "UsernameRecord": {
      "title": "UsernameRecord",
      "description": "Registry to enforce and check unique handles across users",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID that claimed this handle"
        },
        "username": {
          "type": "string",
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_.]+$",
          "description": "The unique handle"
        },
        "createdAt": {
          "type": "string",
          "description": "When the handle was claimed"
        }
      },
      "required": ["uid", "username"]
    },
    "TripRecord": {
      "title": "TripRecord",
      "description": "User saved travel journey and memory collection",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique trip document ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID"
        },
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Trip title"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "description": "Travel story or personal notes"
        },
        "startDate": {
          "type": "string",
          "description": "Trip start date string"
        },
        "endDate": {
          "type": "string",
          "description": "Trip end date string"
        },
        "coverPhotoUrl": {
          "type": "string",
          "description": "Cover photo URL"
        },
        "photoCount": {
          "type": "number",
          "description": "Number of memories/photos"
        },
        "placeCount": {
          "type": "number",
          "description": "Number of places visited"
        },
        "friendCount": {
          "type": "number",
          "description": "Number of companions"
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "friends"],
          "description": "Privacy visibility setting"
        },
        "places": {
          "type": "array",
          "description": "List of visited spots and notes"
        },
        "participants": {
          "type": "array",
          "description": "List of friends who joined"
        },
        "photos": {
          "type": "array",
          "description": "List of uploaded memories"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp"
        }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles where document ID equals Firebase Auth UID"
    },
    "/usernames/{username}": {
      "schema": "UsernameRecord",
      "description": "Unique username registry documents where document ID is the lowercase handle"
    },
    "/users/{userId}/trips/{tripId}": {
      "schema": "TripRecord",
      "description": "User trip collections and travel memories subcollection"
    }
  }
}
